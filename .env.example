# Application
HALYK_PROFILE=full
HALYK_APP_NAME=halyk-agent
HALYK_STAGE=5
# competition (default) | training — training enables the isolated scorer only
# Competition solver uses sanitized manifests from `dataset preflight` (never opens answer keys).
HALYK_MODE=competition

# Archive safety limits (Stage 2)
# HALYK_MAX_ARCHIVE_FILES=10000
# HALYK_MAX_SINGLE_FILE_BYTES=100000000
# HALYK_MAX_TOTAL_UNCOMPRESSED_BYTES=500000000
# HALYK_MAX_COMPRESSION_RATIO=100
# HALYK_MAX_PATH_LENGTH=512
# HALYK_MAX_PROFILE_FILE_BYTES=20000000
# HALYK_MAX_SAMPLE_ROWS=200
# HALYK_MAX_SAMPLE_VALUE_LENGTH=200

# Parser limits / quality (Stage 3 / 5A′)
# HALYK_MAX_PDF_PAGES=500
# HALYK_DOCLING_OCR_ENABLED=false
# HALYK_DOCLING_TABLE_STRUCTURE_ENABLED=true
# HALYK_QUALITY_MAX_EMPTY_PAGE_RATIO=0.5
# Do not enable Docling OCR without explicit approval (may download large models)

# Selective OCR (Stage 5A.4) — explicit backend only; no silent fallback / download
# HALYK_OCR_BACKEND=none
# HALYK_OCR_LANGUAGES=eng+rus+kaz
# HALYK_OCR_MAX_PAGES=32
# HALYK_OCR_TIMEOUT_SECONDS=60
# HALYK_OCR_RENDER_SCALE=2.0
# HALYK_OCR_PSM=6

# FULL profile services (Stage 4) — never start Docker from this project
HALYK_POSTGRES_DSN=postgresql+asyncpg://halyk:halyk@localhost:5432/halyk
HALYK_REDIS_URL=redis://localhost:6379/0

# Reserved for later stages — do not set secrets in committed files
# HALYK_LLM_API_KEY=
# HALYK_LLM_BASE_URL=
